{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "World Labs MCP",
	"version": "0.1.0",
	"identifier": "com.sandraschi.worldlabs-mcp",
	"build": {
		"frontendDist": "../web_sota/dist",
		"devUrl": "http://localhost:10864",
		"beforeDevCommand": "npm --prefix ../web_sota run dev"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "World Labs MCP Operator",
				"width": 1280,
				"height": 860,
				"resizable": true
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": ["nsis"],
		"icon": ["icons/icon.png", "icons/icon.ico"],
		"resources": [
			"resources/worldlabs-mcp-backend.exe"
		],
		"windows": {
			"webviewInstallMode": {
				"type": "skip"
			},
			"nsis": {
				"installMode": "currentUser",
				"installerHooks": "./windows/hooks.nsh"
			}
		}
	},
	"plugins": {}
}



