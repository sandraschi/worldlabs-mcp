min_value = 0.5
max_value = 8.0
step = 0.1
value = 2.0

[node name="SensValue" type="Label" parent="Center/SettingsPanel/Margin/SettingsVBox/SensRow"]
custom_minimum_size = Vector2(48, 0)
layout_mode = 2
text = "2.0"
horizontal_alignment = 2

[node name="ColorblindCheck" type="CheckBox" parent="Center/SettingsPanel/Margin/SettingsVBox"]
layout_mode = 2
text = "Color-blind portal icons (shapes on rings)"

[node name="SettingsBack" type="Button" parent="Center/SettingsPanel/Margin/SettingsVBox"]
layout_mode = 2
text = "Back"

