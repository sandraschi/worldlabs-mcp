horizontal_alignment = 2

[node name="SensRow" type="HBoxContainer" parent="Center/SettingsPanel/Margin/SettingsVBox"]
layout_mode = 2

[node name="SensLabel" type="Label" parent="Center/SettingsPanel/Margin/SettingsVBox/SensRow"]
custom_minimum_size = Vector2(120, 0)
layout_mode = 2
text = "Mouse look"

[node name="SensSlider" type="HSlider" parent="Center/SettingsPanel/Margin/SettingsVBox/SensRow"]
layout_mode = 2
