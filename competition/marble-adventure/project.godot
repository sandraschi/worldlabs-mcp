; Marble Adventure — Competition Entry
; Push the limits of Marble 1.1 with Godot 4.4
[application]
config/name="Marble Adventure"
config/features=PackedStringArray("4.4")
run/main_scene="res://scenes/title.tscn"

[autoload]
GameConfig="*res://scripts/game_config.gd"
PlayerSettings="*res://scripts/player_settings.gd"
SparkNarrator="*res://scripts/spark_narrator.gd"
MCPBridge="*res://mcp_bridge.gd"
WorldManager="*res://scripts/world_manager.gd"
; WorldLoader removed - worlds open in Spark viewer via browser

[rendering]
texture_compression/normal_maps=true
environment/default_clear_color=Color(0.02, 0.02, 0.05, 1)

