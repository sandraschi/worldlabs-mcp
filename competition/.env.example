# Optional overrides for competition/play.ps1
# Copy to .env and edit (never commit .env).

# public_marble | local_spark | public_cdn_spark
MARBLE_ACCESS_MODE=public_marble

# --- itch.io shipping (ship-itch.ps1) ---
# BUTLER_API_KEY=
# itch.io → Account → API keys
ITCH_TARGET=sandraschi/marble-adventure
ITCH_CHANNEL_WIN=win

# Local or hosted Spark webapp (default http://127.0.0.1:10864)
# SPARK_BASE_URL=http://127.0.0.1:10864

# worldlabs-mcp API for local_spark health check (default http://127.0.0.1:10865)
# WORLDLABS_API_URL=http://127.0.0.1:10865
