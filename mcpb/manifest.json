{
  "manifest_version": "0.2",
  "name": "worldlabs-mcp",
  "version": "0.5.0",
  "description": "MCP server wrapping the World Labs Marble API for 3D world generation and the Spark 2.0 spatial viewer",
  "author": { "name": "sandraschi" },
  "server": {
    "type": "python",
    "entry_point": "run_server.py",
    "mcp_config": {
      "command": "uv",
      "args": ["run","--directory","${PWD}","run_server.py"],
      "env": {
        "PYTHONPATH": "${PWD}/src",
        "PYTHONUNBUFFERED": "1"
      }
    }
  },
  "tools": [
    { "name": "get_system_stats", "description": "get_system_stats" },
    { "name": "push_narration", "description": "push_narration" },
